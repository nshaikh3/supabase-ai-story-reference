{
  "name": "supabase-ai-story-reference",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3100",
    "build": "node --env-file-if-exists=.env.local scripts/build-check.mjs && next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run docs:check && npm run test && npm run typecheck && npm run lint && npm run build",
    "docs:check": "node scripts/docs-check.mjs",
    "supabase:start": "node scripts/supabase-local.mjs start",
    "supabase:start:core": "node scripts/supabase-local.mjs start-core",
    "supabase:stop": "node scripts/supabase-local.mjs stop",
    "db:reset": "node scripts/supabase-local.mjs reset",
    "db:test": "node scripts/supabase-local.mjs test",
    "db:lint": "node scripts/supabase-local.mjs lint",
    "db:types": "node scripts/supabase-local.mjs types",
    "db:types:check": "node scripts/supabase-local.mjs types-check",
    "local:check": "node scripts/supabase-local.mjs check",
    "test:e2e": "playwright test",
    "local:env": "node scripts/supabase-local.mjs env",
    "db:advisors": "node scripts/supabase-local.mjs advisors",
    "generation:setup": "node scripts/supabase-local.mjs generation-setup",
    "db:performance": "node scripts/supabase-local.mjs performance",
    "ops:status": "node scripts/operations-local.mjs status",
    "ops:pause": "node scripts/operations-local.mjs pause",
    "ops:resume": "node scripts/operations-local.mjs resume",
    "ops:maintenance": "node scripts/operations-local.mjs maintenance",
    "ops:cleanup": "node scripts/operations-local.mjs cleanup-plan",
    "ops:cleanup:apply": "node scripts/operations-local.mjs cleanup-apply",
    "ops:worker:rotate": "node scripts/operations-local.mjs worker-rotate",
    "db:concurrency": "node scripts/resource-concurrency-local.mjs",
    "staging:preflight": "node scripts/staging-preflight.mjs",
    "test:staging": "playwright test --config playwright.staging.config.mts",
    "release:worker:prepare": "node scripts/worker-handoff.mjs",
    "build:showcase": "node scripts/showcase-build.mjs",
    "preview:showcase": "node scripts/showcase-preview.mjs",
    "test:showcase": "playwright test --config playwright.showcase.config.mts",
    "test:showcase:live": "playwright test --config playwright.showcase-live.config.mts"
  },
  "dependencies": {
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.32",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.8",
    "smol-toml": "1.9.0",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
